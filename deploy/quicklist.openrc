#!/sbin/openrc-run
# Expose on the tailnet with: tailscale serve --bg --https=8443 http://127.0.0.1:8080

name="quicklist"
description="Quick List"
command="/usr/local/bin/quicklist"
command_user="quicklist"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/quicklist.log"
error_log="/var/log/quicklist.log"
export QUICKLIST_ADDR="127.0.0.1:8080"
export QUICKLIST_DB="/var/lib/quicklist/database.sqlite"

depend() {
	need net
}
